{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludoproof-game-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "LUDOPROOF_MATCHES",
        "class_name": "MatchRoom"
      },
      {
        "name": "LUDOPROOF_API_GATE",
        "class_name": "ApiGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MatchRoom"
      ]
    },
    {
      "tag": "v2-rate-gate",
      "new_sqlite_classes": [
        "ApiGate"
      ]
    }
  ],
  "vars": {
    "ENTRONEX_BASE_URL": "https://entronex-v4-eval.ai-8f3.workers.dev",
    "ENTRONEX_SIGNING_KEY_ID": "cf-v4-eval-sign-1",
    "ENTRONEX_TENANT_ID": "cloudflare_v4_eval"
  }
}
